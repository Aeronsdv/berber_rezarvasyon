generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
enum Role {
  CUSTOMER
  OWNER
}
enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  NO_SHOW
  CANCELLED
}
enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}
model User {
  id String @id @default(cuid())
  name String?
  email String? @unique
  emailVerified DateTime?
  image String?
  phone String?
  role Role @default(CUSTOMER)
  createdAt DateTime @default(now())
  accounts Account[]
  sessions Session[]
  shops Barbershop[]
  appointments Appointment[]
  bans CustomerBan[]
  favorites Favorite[]
  reviews Review[]
}
model Account {
  userId String
  type String
  provider String
  providerAccountId String
  refresh_token String? @db.Text
  access_token String? @db.Text
  expires_at Int?
  token_type String?
  scope String?
  id_token String? @db.Text
  session_state String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([provider, providerAccountId])
}
model Session {
  sessionToken String @unique
  userId String
  expires DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model VerificationToken {
  identifier String
  token String
  expires DateTime
  @@id([identifier, token])
}
model Barbershop {
  id String @id @default(cuid())
  ownerId String
  name String
  slug String @unique
  description String @default("")
  address String
  city String
  district String
  latitude Float
  longitude Float
  phone String
  coverImage String?
  isActive Boolean @default(true)
  slotInterval Int @default(15)
  bookingWindowDays Int @default(30)
  createdAt DateTime @default(now())
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  hours WorkingHours[]
  staff Staff[]
  services Service[]
  appointments Appointment[]
  bans CustomerBan[]
  reviews Review[]
  favorites Favorite[]
  subscription Subscription?
  @@index([ownerId])
  @@index([isActive, city, district])
}
model WorkingHours {
  id String @id @default(cuid())
  barbershopId String
  dayOfWeek Int
  openMin Int @default(540)
  closeMin Int @default(1200)
  isClosed Boolean @default(false)
  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  @@unique([barbershopId, dayOfWeek])
}
model Staff {
  id String @id @default(cuid())
  barbershopId String
  name String
  title String @default("Berber")
  photo String?
  isActive Boolean @default(true)
  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Restrict)
  hours StaffHours[]
  breaks StaffBreak[]
  appointments Appointment[]
  @@index([barbershopId])
}
model StaffHours {
  id String @id @default(cuid())
  staffId String
  dayOfWeek Int
  openMin Int
  closeMin Int
  isClosed Boolean @default(false)
  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  @@unique([staffId, dayOfWeek])
}
model StaffBreak {
  id String @id @default(cuid())
  staffId String
  date String @db.VarChar(10)
  startMin Int
  endMin Int
  reason String @default("Mola")
  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  @@index([staffId, date])
}
model Service {
  id String @id @default(cuid())
  barbershopId String
  name String
  durationMinutes Int
  price Decimal @db.Decimal(10, 2)
  isActive Boolean @default(true)
  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Restrict)
  appointments Appointment[]
  @@index([barbershopId])
}
model Appointment {
  id String @id @default(cuid())
  barbershopId String
  customerId String
  staffId String
  serviceId String
  date String @db.VarChar(10)
  startMin Int
  endMin Int
  startsAt DateTime @db.Timestamptz(3)
  endsAt DateTime @db.Timestamptz(3)
  status AppointmentStatus @default(CONFIRMED)
  cancelReason String?
  serviceName String
  price Decimal @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Restrict)
  customer User @relation(fields: [customerId], references: [id], onDelete: Restrict)
  staff Staff @relation(fields: [staffId], references: [id], onDelete: Restrict)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  review Review?
  notifications Notification[]
  @@index([staffId, date])
  @@index([customerId, date])
  @@index([barbershopId, date])
}
model CustomerBan {
  id String @id @default(cuid())
  barbershopId String
  customerId String
  bannedUntil DateTime? @db.Timestamptz(3)
  reason String
  createdAt DateTime @default(now())
  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)
  @@unique([barbershopId, customerId])
}
model Favorite {
  userId String
  barbershopId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  @@id([userId, barbershopId])
}
model Review {
  id String @id @default(cuid())
  appointmentId String @unique
  customerId String
  barbershopId String
  rating Int
  comment String
  createdAt DateTime @default(now())
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  customer User @relation(fields: [customerId], references: [id], onDelete: Restrict)
  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  @@index([barbershopId])
}
model Subscription {
  id String @id @default(cuid())
  barbershopId String @unique
  status SubscriptionStatus @default(TRIAL)
  trialEndsAt DateTime
  provider String?
  providerCustomerId String? @unique
  providerSubscriptionId String? @unique
  currentPeriodEnd DateTime?
  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
}
model Notification {
  id String @id @default(cuid())
  appointmentId String
  kind String
  recipient String
  scheduledAt DateTime
  sentAt DateTime?
  attempts Int @default(0)
  lastError String?
  lockedUntil DateTime?
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  @@unique([appointmentId, kind, recipient])
  @@index([sentAt, scheduledAt])
}
